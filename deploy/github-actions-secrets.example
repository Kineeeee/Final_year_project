# GitHub Actions secrets/vars template
# Use this file as a checklist only. Do NOT commit real secrets.
# In GitHub: Repo -> Settings -> Secrets and variables -> Actions

# -----------------------------
# Repository Secrets (required)
# -----------------------------
# Cannot infer from repository. Use your VPS public IP or deploy domain.
DEPLOY_HOST=<YOUR_VPS_PUBLIC_IP_OR_DOMAIN>

# Default common SSH user on Ubuntu VPS. Change if your server uses another user.
DEPLOY_USER=ubuntu

# Paste full private key content as multi-line text in GitHub Secret UI.
# Example header/footer only:
DEPLOY_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----

# Personal access token used by VPS to docker login ghcr.io
# Required scopes: read:packages (and optionally write:packages if needed)
GHCR_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------
# Repository Variables (required)
# -----------------------------
# Public game URL used for Vite build arg in workflow.
# In this project, web and API are expected behind the same domain via Nginx proxy.
# Example from deployment docs:
GAME_PUBLIC_URL=https://game.example.com

# Optional convenience variable if you want to hardcode owner.
# In workflow this is already derived from github.repository_owner.
# In this repository, owner is:
GHCR_OWNER=Kineeeee

# -----------------------------
# Quick validation checklist
# -----------------------------
# 1) Secret names must match workflow exactly:
#    DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, GHCR_PAT
# 2) Secrets are created in the same repository that runs the workflow.
# 3) If using Environment secrets, deploy job must set that environment.
# 4) DEPLOY_HOST must be non-empty; otherwise appleboy/ssh-action errors with:
#    "missing server host"
