PORT=3000
NODE_ENV=production

# Allow only your real frontend domains
CORS_ORIGINS=https://game.example.com

# Required auth secrets (replace with long random values)
JWT_SECRET=replace_with_long_random_string
REFRESH_SECRET=replace_with_another_long_random_string

# Use managed services for production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/phaser_snake
REDIS_ENABLED=true
REDIS_URL=redis://your-redis-host:6379

# Optional LLM settings
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=replace_me
LLM_MODEL=google/gemma-3-4b
