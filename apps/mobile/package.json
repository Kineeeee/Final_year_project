{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:apk": "npx eas-cli build -p android --profile apk",
    "build:android:preview": "npx eas-cli build -p android --profile preview",
    "build:android:prod": "npx eas-cli build -p android --profile production",
    "build:ios:ipa": "npx eas-cli build -p ios --profile ipa",
    "build:ios:preview": "npx eas-cli build -p ios --profile preview",
    "build:ios:prod": "npx eas-cli build -p ios --profile production",
    "submit:android": "npx eas-cli submit -p android --latest",
    "submit:ios": "npx eas-cli submit -p ios --latest"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-screen-orientation": "~9.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "private": true
}
